# Godot
.godot/
*.translation

# Arquivos compactados grandes (originais ficam fora do git)
*.rar
*.7z

# Dados externos grandes / de terceiros (ver CLAUDE.md: o snapshot nunca vai para o git)
/poke har/
/poke-local/
/laboratorio_validacao/

# Capturas HAR podem conter cookies e tokens da conta
*.har

# Dados privados de execução: nunca versionar gravações, sessões ou saves reais.
/gravacoes/
/saves/
*.jsonl
progresso_v*.json*
.env
.env.*
!.env.example
/dados/regras/perfil.txt

# Python
__pycache__/
*.pyc

# Saídas de teste da simulação
/saida_testes/
/cache/

# Gerado por test_configuracao_hunts.gd (teste do P04) a cada execução
cenario_teste_config.tscn

/builds/

# referência visual (vídeos do usuário e quadros extraídos; grandes)
/referencia_visual/*.mp4
/referencia_visual/quadros/brutos/
/referencia_visual/quadros/folhas/
/referencia_visual/quadros/*/
!/referencia_visual/quadros/indice_telas.md
